<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GBlog - Personal Blog</title>
    <!-- Modern Font Entegrasyonu -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
            --border-color: #334155;
            --tag-bg: rgba(56, 189, 248, 0.1);
            --tag-text: #38bdf8;
            --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            line-height: 1.6;
        }

        /* Navbar Tasarımı */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 8%;
            background-color: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent);
            letter-spacing: -0.5px;
            text-decoration: none;
        }

        .nav-links ul {
            display: flex;
            gap: 1.5rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
        }

        .nav-links a:hover {
            color: var(--accent);
            background-color: rgba(255, 255, 255, 0.05);
        }

        /* Ana İçerik ve Grid */
        .container {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
        }

        /* Blog Kartı Tasarımı */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow);
            transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
        }

        /* Header (Yazar ve Etiket) */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .author {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .author::before {
            content: "•";
            color: var(--accent);
            font-size: 1.2rem;
        }

        .tag {
            background-color: var(--tag-bg);
            color: var(--tag-text);
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid rgba(56, 189, 248, 0.2);
        }

        /* İçerik */
        .card-body {
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }

        .card h2 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 0.75rem;
            line-height: 1.4;
        }

        .card p {
            color: var(--text-muted);
            font-size: 0.92rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Footer (Tarih Bilgisi) */
        .card-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 1rem;
            display: flex;
            justify-content: flex-end;
        }

        .date {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Responsive */
        @media (max-width: 640px) {
            .navbar {
                padding: 1rem 5%;
            }
            .container {
                grid-template-columns: 1fr;
                margin: 2rem auto;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/blog" class="logo">GBlog</a>
        <div class="nav-links">
            <ul>
                <li><a href="/blog">Home</a></li>
                <li><a href="/create">Create</a></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        <% blogList.forEach(u => { %>
            <article class="card">
                <!-- Üst Kısım: Yazar Adı ve Kategori Etiketi -->
                <div class="card-header">
                    <span class="author">@<%= u.username %></span>
                    <span class="tag"><%= u.type %></span>
                </div>

                <!-- Orta Kısım: Başlık ve Açıklama -->
                <div class="card-body">
                    <h2><%= u.title %></h2>
                    <p><%= u.desc %></p>
                </div>

                <!-- Alt Kısım: Formatlanmış Tarih -->
                <div class="card-footer">
                    <span class="date">
                        <%= u.date %>
                    </span>
                </div>
            </article>
        <% }); %>
    </main>

</body>
</html>